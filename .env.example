# ChainStory — Environment Variables
# Copy this file to .env and fill in your API keys

# Etherscan API Key — get a free key at https://etherscan.io/myapikey
VITE_ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Google Gemini API Key — get a free key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# CoinGecko — no key required for free tier historical price lookups
