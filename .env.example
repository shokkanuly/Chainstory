# ChainStory — Environment Variables
# Copy this file to .env and fill in your API keys

# Google Gemini API Key (Required for AI descriptions with Structured Output schema)
# Get a free key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Primary Etherscan API Key (Ethereum Mainnet)
# Get a free key at https://etherscan.io/myapikey
VITE_ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Multi-Chain Explorer API Keys (Optional - falls back to VITE_ETHERSCAN_API_KEY if unset)
VITE_ARBISCAN_API_KEY=your_arbiscan_api_key_here
VITE_BASESCAN_API_KEY=your_basescan_api_key_here
VITE_OPTIMISM_API_KEY=your_optimism_api_key_here
VITE_POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

