# ChainStory / Retold — environment variables
#
# These are SERVER-side only. They are read by the /api proxy functions and are
# never exposed to the browser.
#
# Note the missing VITE_ prefix: that prefix is what caused the old setup to
# inline keys into the public client bundle, where anyone could read them.
# Do not add it back.

# Explorer key (required for live data; without it the app runs on clearly
# labelled demo data). Free key: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Per-chain keys (optional — each falls back to ETHERSCAN_API_KEY)
ARBISCAN_API_KEY=
BASESCAN_API_KEY=
OPTIMISM_API_KEY=
POLYGONSCAN_API_KEY=

# Google Gemini (optional). Without it, descriptions come from the
# deterministic keyword engine, which covers 100% of transactions offline.
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Tripwire operator (scripts/tripwire; keep real values in .env.tripwire) ---
# Independent verifier RPCs (ADR-022), comma-separated, run by different
# providers than the primary *_RPC_URL. Source proofs are accepted only when
# every answering provider agrees and at least TRIPWIRE_RPC_QUORUM answer
# (default: all of them). One dissent holds the release; it never approves it.
BASE_SEPOLIA_VERIFIER_RPC_URLS=
SEPOLIA_VERIFIER_RPC_URLS=
TRIPWIRE_RPC_QUORUM=
