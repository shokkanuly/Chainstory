{
  // The Tripwire operator scripts (watcher, attestor, demo). Node at runtime,
  // but they import src/ modules written for the bundler, so they resolve
  // the same way the app does.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["scripts/tripwire"]
}
